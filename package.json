{
  "name": "bitcrate",
  "productName": "BitCrate",
  "version": "0.1.2",
  "private": true,
  "description": "Turns Spotify playlists into tagged music files",
  "author": "Moustafa",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run --passWithNoTests",
    "smoke": "electron-vite build && vitest run --config vitest.smoke.config.ts",
    "dist": "node scripts/fetch-tools.mjs && electron-vite build && electron-builder --win",
    "fetch-tools": "node scripts/fetch-tools.mjs",
    "predev": "node scripts/fetch-tools.mjs"
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moustafaeledwy/bitcrate.git"
  },
  "homepage": "https://github.com/moustafaeledwy/bitcrate"
}
